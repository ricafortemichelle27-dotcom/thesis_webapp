# Copy to %LOCALAPPDATA%\ThesisKiosk\mysql.env (outside Git/OneDrive), or inject as service environment.
KIOSK_DB_HOST=127.0.0.1
KIOSK_DB_PORT=3306
KIOSK_DB_NAME=kiosk_local_db
KIOSK_DB_USER=kiosk_local_app
KIOSK_DB_PASSWORD=replace-with-a-unique-random-local-password
KIOSK_BRIDGE_PORT=5182
KIOSK_UI_ORIGINS=http://127.0.0.1:5174

# Used only for the initial schema migration; never reuse central credentials at runtime.
# KIOSK_DB_ADMIN_USER=local-migration-user
# KIOSK_DB_ADMIN_PASSWORD=local-migration-password

KIOSK_BACKEND_ORIGIN=https://your-backend.example
KIOSK_SYNC_TOKEN=replace-with-a-separate-random-sync-token-at-least-32-characters
KIOSK_EVENT_IDS=
KIOSK_STUDENT_IDS=

# Tests use temporary schemas and require a separate local test account with CREATE/DROP permissions.
# KIOSK_TEST_DB_USER=local-test-user
# KIOSK_TEST_DB_PASSWORD=local-test-password
